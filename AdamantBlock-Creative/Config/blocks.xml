<configs>

	<!-- ================================================================
	     Adamant block, full shape set (shapes="All"). Identical to the
	     survival edition MINUS the rare-ore Harvest drops (Creative has no
	     adamantOre item).
	     ================================================================ -->
	<append xpath="/blocks">
		<block name="adamantShapes" shapes="All">
			<property name="DescriptionKey" value="adamantBlockGroupDesc"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="Material" value="MAdamant_shapes"/>
			<property name="Shape" value="New"/>
			<!-- 356 = vanilla steel; only visible if the custom texture cannot be
			     installed. AdamantBlock.dll appends the adamant texture to the opaque
			     atlas at load and rewrites this id at runtime (src/dll/AdamantAtlas.cs).
			     Keep it numeric - a name would need a core mod to resolve. -->
			<property name="Texture" value="356"/>
			<property name="EconomicValue" value="50"/>
			<property class="RepairItems">
				<property name="resourceWood" value="1"/>
			</property>
			<drop event="Harvest" name="resourceWood" count="1" tag="allHarvest,perkJunkMiner"/>
			<drop event="Destroy" count="0"/>
			<property name="UpgradeSound" value="place_block_metal"/>
			<property name="SoundPickup" value="steelblock_grab"/>
			<property name="SoundPlace" value="steelblock_place"/>
			<property name="SortOrder1" value="a010"/>
			<property name="Group" value="Building,advBuilding"/>
			<property name="FilterTags" value="MC_Shapes"/>
		</block>
	</append>

	<!-- ================================================================
	     Adamant Spikes Trap. Identical to the survival edition except that
	     repair/harvest use wood instead of the (creative-absent) ingot.
	     See the survival blocks.xml for the full rationale behind
	     Damage / Damage_received / the deliberately missing BlockTag, and
	     for why the model is retextured by the DLL instead of tinted.
	     ================================================================ -->
	<append xpath="/blocks">
		<block name="adamantSpikesTrap">
			<property name="Class" value="TrunkTip"/>
			<property name="Damage" value="60"/>
			<property name="Damage_received" value="0"/>
			<property name="MovementFactor" value="0.25"/>
			<property name="DescriptionKey" value="adamantSpikesTrapDesc"/>
			<property name="DisplayType" value="blockHardened"/>
			<property name="Material" value="MAdamant_shapes"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Traps/ironSpikesTrapPrefab.prefab"/>
			<property name="CustomIcon" value="trapSpikesScrapIronMaster"/>
			<property name="CustomIconTint" value="7B4FB0"/>
			<property name="ImposterExclude" value="true"/>
			<property name="LightOpacity" value="6"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="Collide" value="melee"/>
			<property name="Path" value="solid"/>
			<property name="IsTerrainDecoration" value="false"/>
			<property name="EconomicValue" value="500"/>
			<property name="SoundPickup" value="trapiron_grab"/>
			<property name="SoundPlace" value="trapiron_place"/>
			<property class="RepairItems">
				<property name="resourceWood" value="1"/>
			</property>
			<property name="UpgradeSound" value="place_block_metal"/>
			<drop event="Harvest" name="resourceWood" count="1" tag="allHarvest,perkJunkMiner"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" count="0"/>
			<property name="SortOrder1" value="a011"/>
			<property name="Group" value="Building,advBuilding"/>
			<property name="FilterTags" value="MC_building,SC_traps"/>
		</block>
	</append>

</configs>
